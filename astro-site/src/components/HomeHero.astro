---
import { readFileSync } from 'node:fs';
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import Button from '@ambiqai/helia-ui/astro/Button';
const { data } = Astro.locals.starlightRoute.entry;
const source = readFileSync('../pyproject.toml', 'utf8');
const version = source.match(/^version\s*=\s*"([^"]+)"/m)?.[1];
if (!version) throw new Error('Missing compressionKIT version in pyproject.toml');
const base = import.meta.env.BASE_URL;
const isHome = Astro.url.pathname.replace(/\/+$/, '') === base.replace(/\/+$/, '');
const tasks = [['PPG codecs', 'signals/ppg'], ['ECG codecs', 'signals/ecg'], ['Build your own codec', 'adding-a-codec-family']];
const capabilities = [
  ['01', 'Prepare signals', 'ECG and PPG preprocessing'],
  ['02', 'Build codecs', 'Neural, DSP and hybrid methods'],
  ['03', 'Evaluate results', 'Waveform and physiological scorecards'],
  ['04', 'Prepare for the edge', 'Models, manifests and reference vectors'],
];
---
{isHome && data.hero?.tagline ? <>
  <section class="compressionkit-hero" aria-labelledby="_top">
    <div class="hero-meta"><span class="product"><img src={`${base}/assets/compressionkit-icon.png`} alt="" width="28" height="28" />compressionKIT</span><span class="version">v{version}</span></div>
    <div class="hero-layout">
      <div class="hero-copy">
        <h1 id="_top">Keep the signal.<br /><span>Carry less data.</span></h1>
        <p>{data.hero.tagline}</p>
        <nav class="hero-actions" aria-label="Get started with compressionKIT">
          <a class="primary" href={`${base}/getting-started/`}>Get started</a>
          <a href={`${base}/examples/`}>Explore examples</a>
        </nav>
      </div>
      <div class="capabilities" aria-label="compressionKIT capabilities">
        <p class="capabilities-label">From samples to a codec</p>
        <ol>{capabilities.map(([number, title, description]) => <li><span class="step">{number}</span><div><strong>{title}</strong><span>{description}</span></div></li>)}</ol>
      </div>
    </div>
  </section>
  <nav class="task-links" aria-label="Explore compression workflows">
    {tasks.map(([label, slug]) => <Button variant="secondary" size="sm" href={`${base}/${slug}/`}>{label} <span aria-hidden="true">↗</span></Button>)}
  </nav>
</> : <DefaultHero />}
<style>
  .compressionkit-hero { --hero-yellow: #ffeb3b; --hero-green: #9cf050; background: #101318; color: #d6d9e0; border: 1px solid #292f38; border-radius: 1.5rem; padding: clamp(1.5rem, 4vw, 3.5rem); }
  .hero-meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 2.25rem; }
  .product { display: inline-flex; align-items: center; gap: .6rem; color: #f1f3f7; font-size: clamp(1.75rem, 3vw, 2.4rem); font-weight: 750; letter-spacing: -.04em; }
  .product img { display: block; width: 1.5rem; height: 1.5rem; object-fit: contain; }
  .version { border: 1px solid #525966; border-radius: 999px; padding: .35rem .8rem; color: #c1c7d1; white-space: nowrap; font-size: .9rem; font-variant-numeric: tabular-nums; }
  .hero-layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  h1 { color: #fff; font-size: clamp(2.25rem, 3.5vw, 3.5rem); line-height: 1.1; letter-spacing: -.04em; margin: 0 0 1.5rem; }
  h1 span { display: inline-block; color: var(--hero-yellow); background: linear-gradient(90deg, var(--hero-yellow), #d9f143 55%, var(--hero-green)); background-clip: text; -webkit-text-fill-color: transparent; }
  @media (forced-colors: active) { h1 span { background: none; -webkit-text-fill-color: currentColor; } }
  .hero-copy p { max-width: 57ch; font-size: 1.08rem; line-height: 1.75; }
  nav { display: flex; flex-wrap: wrap; gap: .75rem; }
  .hero-actions { margin-top: 2rem; }
  .hero-actions a { display: inline-flex; align-items: center; gap: .75rem; padding: .7rem 1.15rem; border: 1px solid #505761; border-radius: 999px; color: #f3f4f7; text-decoration: none; font-weight: 600; }
  .hero-actions .primary { color: #151219; background: var(--hero-yellow); border-color: var(--hero-yellow); }
  .hero-actions a:hover { border-color: var(--hero-green); background: #28212b; }
  .hero-actions .primary:hover { color: #151219; background: #fff47a; }
  .hero-actions a:focus-visible { outline: 2px solid var(--hero-yellow); outline-offset: 4px; }
  .capabilities { background: #191e25; border: 1px solid #343d49; border-radius: 1.15rem; padding: 1.35rem; }
  .capabilities-label { color: #c1c7d1; text-transform: uppercase; letter-spacing: .1em; font-size: .72rem; font-weight: 600; margin: 0 0 1.15rem; }
  ol { display: grid; gap: .65rem; list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: .85rem; border: 1px solid #363f4b; background: #202731; border-radius: .6rem; padding: .85rem; }
  .step { color: var(--hero-yellow); font-size: .78rem; font-variant-numeric: tabular-nums; }
  li:nth-child(even) .step { color: var(--hero-green); }
  li strong { display: block; color: #f0f2f6; font-size: .95rem; }
  li div > span { display: block; color: #bbc3d0; font-size: .8rem; margin-top: .2rem; line-height: 1.45; }
  .task-links { justify-content: center; margin: 1.75rem 0 .25rem; }
  @media (max-width: 60rem) { .hero-layout { grid-template-columns: 1fr; } .hero-copy p { max-width: 65ch; } ol { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 34rem) { ol { grid-template-columns: 1fr 1fr; } li { padding: .65rem; align-items: flex-start; } li .step { display: none; } li strong { font-size: .85rem; } li div > span { font-size: .75rem; } .hero-meta { margin-bottom: 1.75rem; } .task-links { gap: .5rem; } }
</style>
